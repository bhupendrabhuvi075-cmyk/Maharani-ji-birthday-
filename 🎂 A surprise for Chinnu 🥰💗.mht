#om-bday-stage > #om-bday-sky, #om-bday-stage > .om-bday-blob, #om-bday-stage > .om-bday-moonglow, #om-bday-stage > .om-bday-particles { z-index: 0; }

.om-bday-scene { z-index: 2; }

#om-bday-stage { --tilt-x: 0; --tilt-y: 0; }

.om-bday-sheen::after { content: ""; position: absolute; inset: 0px; border-radius: inherit; pointer-events: none; z-index: 4; background: radial-gradient(58% 52% at 50% 32%, rgba(255, 255, 255, 0.16) 0px, rgba(255, 255, 255, 0) 62%); }

.om-bday-scene { position: absolute; inset: 0px; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: calc(70px + env(safe-area-inset-top,0px)) max(20px,env(safe-area-inset-right,0px)) calc(88px + env(safe-area-inset-bottom,0px)) max(20px,env(safe-area-inset-left,0px)); opacity: 0; pointer-events: none; transform: translateY(14px); transition: opacity 0.28s, transform 0.45s; overflow: hidden auto; text-align: center; }

.om-bday-scene.is-on { opacity: 1; pointer-events: auto; transform: translateY(0px); transition: opacity 0.5s 0.16s, transform 0.55s cubic-bezier(0.2, 0.7, 0.3, 1) 0.06s; }

.om-bday-scene-inner { margin: auto; width: 100%; max-width: 460px; }

.om-bday-hint { font-size: 15px; font-weight: 600; color: var(--bd-ink-soft); min-height: 24px; transition: opacity 0.35s; }

.om-bday-hint.is-swap { opacity: 0; }

.om-bday-gate-tag { width: min(320px, 84vw); margin: 0px auto 26px; background: linear-gradient(160deg, rgb(61, 36, 56) 0px, rgb(42, 24, 48) 100%); border: 1.5px solid rgba(var(--bd-line-rgb),.5); border-radius: 22px; padding: 30px 22px 26px; position: relative; box-shadow: 0 18px 50px rgba(0,0,0,.5),0 0 60px rgba(var(--bd-line-rgb),.08); }

.om-bday-gate-tag::before { content: ""; position: absolute; top: -13px; left: 50%; transform: translateX(-50%); width: 26px; height: 26px; border-radius: 50%; background: var(--bd-night); border: 1.5px solid rgba(var(--bd-line-rgb),.5); }

.om-bday-gate-emoji { font-size: 52px; animation: 2.2s ease-in-out 0s infinite normal none running om-bday-gift-rock; margin-bottom: 12px; }

@keyframes om-bday-gift-rock { 
  0%, 100% { transform: rotate(-6deg); }
  50% { transform: rotate(6deg); }
}

.om-bday-gate-for { font-size: 13px; font-weight: 800; letter-spacing: 0.22em; color: var(--bd-ink-dim); text-transform: uppercase; margin-bottom: 6px; }

.om-bday-gate-name { font-family: var(--bd-font-script); font-size: 31px; line-height: 1.1; color: var(--bd-gold); margin-bottom: 12px; overflow-wrap: anywhere; }

.om-bday-gate-sub { font-size: 14.5px; color: var(--bd-ink-soft); line-height: 1.55; }

.om-bday-gate-sound { font-size: 12.5px; color: var(--bd-ink-dim); margin-top: 14px; }

#om-bday-gate-btn { max-width: 300px; margin: 0px auto; }

.om-bday-count-title { font-family: var(--bd-font-display); font-size: 24px; font-weight: 600; margin-bottom: 8px; }

.om-bday-count-sub { font-size: 14px; color: var(--bd-ink-soft); margin-bottom: 26px; }

.om-bday-count-digits { display: flex; justify-content: center; gap: 10px; margin-bottom: 26px; }

.om-bday-count-cell { min-width: clamp(72px, 26vw, 84px); background: rgba(var(--bd-panel-rgb),.8); border: 1px solid rgba(var(--bd-line-rgb),.3); border-radius: 18px; padding: 14px 8px 10px; }

.om-bday-count-num { font-family: var(--bd-font-display); font-size: 38px; font-weight: 600; color: var(--bd-gold); font-variant-numeric: tabular-nums; line-height: 1; }

.om-bday-count-word { font-size: 10.5px; font-weight: 800; letter-spacing: 0.14em; color: var(--bd-ink-dim); text-transform: uppercase; margin-top: 6px; }

.om-bday-peek { display: none; margin: 8px auto 0px; font-size: 13.5px; color: var(--bd-ink-dim); text-decoration: underline; text-underline-offset: 3px; padding: 12px; min-height: 44px; }

.om-bday-peek.is-shown { display: inline-block; }

.om-bday-arrival-kicker { font-size: 15px; font-weight: 800; letter-spacing: 0.28em; text-transform: uppercase; color: var(--bd-ink-soft); opacity: 0; transform: translateY(14px); }

.om-bday-arrival-big { font-family: var(--bd-font-display); font-size: clamp(40px, 11vw, 64px); font-weight: 600; line-height: 1.06; color: var(--bd-ink); margin: 10px 0px 6px; opacity: 0; transform: translateY(14px); }

.om-bday-arrival-name { font-family: var(--bd-font-script); font-size: clamp(31px, 8.4vw, 50px); line-height: 1.15; color: var(--bd-gold); text-shadow: 0 0 34px rgba(var(--bd-line-rgb),.45); opacity: 0; transform: translateY(14px); overflow-wrap: anywhere; }

.om-bday-arrival-age { font-size: 16.5px; color: var(--bd-champagne); margin-top: 14px; opacity: 0; transform: translateY(14px); }

.om-bday-arrival-age b { color: var(--bd-gold); font-family: var(--bd-font-display); font-size: 20px; }

.om-bday-arrival-tap { margin-top: 34px; font-size: 13px; color: var(--bd-ink-dim); opacity: 0; }

.om-bday-rise { animation: 0.8s cubic-bezier(0.2, 0.7, 0.3, 1) 0s 1 normal both running om-bday-rise-in; }

@keyframes om-bday-rise-in { 
  0% { opacity: 0; transform: translateY(18px); }
  100% { opacity: 1; transform: translateY(0px); }
}

.om-bday-scene--tree { padding: 0px; display: block; overflow: hidden; background: rgb(18, 6, 12); }

.om-bday-tree-canvas { position: absolute; inset: 0px; width: 100%; height: 100%; display: block; z-index: 1; }

.om-bday-tree-vignette { position: absolute; inset: 0px; z-index: 2; pointer-events: none; background: radial-gradient(125% 96% at 50% 42%, transparent 55%, rgba(70, 20, 34, 0.12) 84%, rgba(48, 14, 24, 0.26) 100%); mix-blend-mode: multiply; }

.om-bday-tree-wish { position: absolute; left: 7%; bottom: 13%; max-width: min(84%, 440px); z-index: 6; pointer-events: none; text-align: left; color: rgb(122, 74, 85); visibility: hidden; }

.om-bday-tree-wish.is-in { visibility: visible; }

.om-bday-tree-wish::before { content: ""; position: absolute; inset: -18% -24% -24% -16%; background: radial-gradient(84% 98% at 34% 52%, rgba(255, 250, 243, 0.94), rgba(255, 250, 243, 0.6) 48%, rgba(255, 250, 243, 0) 80%); z-index: -1; opacity: 0; transition: opacity 1s; }

.om-bday-tree-wish.is-in::before { opacity: 1; }

.om-bday-tree-eyebrow { font-family: var(--bd-font-display); font-style: italic; font-weight: 600; font-size: clamp(13px, 3.2vw, 22px); letter-spacing: 0.05em; color: rgb(156, 79, 99); text-shadow: rgb(255, 248, 241) 0px 1px 2px, rgba(255, 248, 241, 0.95) 0px 0px 8px; }

.om-bday-tree-herowrap { position: relative; display: inline-block; }

.om-bday-tree-herowrap::before { content: ""; position: absolute; inset: -26% -12% -22%; background: radial-gradient(60% 70% at 46% 52%, rgba(255, 214, 168, 0.5), rgba(255, 150, 150, 0.2) 52%, transparent 74%); filter: blur(14px); z-index: -1; opacity: 0; pointer-events: none; }

.om-bday-tree-herowrap::after { content: "âœ¦"; position: absolute; right: -2%; top: -14%; font-size: clamp(15px, 3.6vw, 30px); color: rgb(255, 225, 160); text-shadow: rgba(255, 205, 120, 0.95) 0px 0px 12px; opacity: 0; pointer-events: none; }

.om-bday-tree-hero { font-family: var(--bd-font-script); font-weight: 700; font-size: clamp(27px, 7vw, 55px); line-height: 1; margin: -0.02em 0px 0.06em; background: linear-gradient(rgb(232, 90, 131) 0px, rgb(196, 31, 82) 50%, rgb(156, 15, 66) 100%) text; color: transparent; filter: drop-shadow(rgba(255, 252, 248, 0.98) 0px 1px 1px) drop-shadow(rgba(130, 18, 55, 0.45) 0px 2px 6px); clip-path: inset(0px 100% -28% -10%); transform-origin: 8% 60%; }

.om-bday-tree-rule { display: block; width: clamp(46px, 13vw, 110px); height: 2px; margin: 0.12em 0px 0.48em; background: linear-gradient(90deg,var(--bd-gold),rgba(227,154,46,0)); box-shadow: rgba(255, 247, 240, 0.9) 0px 0px 8px; transform-origin: left center; }

.om-bday-tree-sub { font-family: var(--bd-font-display); font-weight: 600; font-style: italic; font-size: clamp(13px, 3.2vw, 20px); letter-spacing: 0.03em; color: rgb(110, 63, 74); text-shadow: rgb(255, 248, 241) 0px 1px 2px, rgba(255, 248, 241, 0.98) 0px 0px 8px; }

.om-bday-tree-eyebrow, .om-bday-tree-rule, .om-bday-tree-sub { opacity: 0; transform: translateY(12px); filter: blur(5px); transition: opacity 0.8s, transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1), filter 0.8s; }

.om-bday-tree-rule { transform: translateY(12px) scaleX(0.3); }

.om-bday-tree-wish.is-in .om-bday-tree-eyebrow, .om-bday-tree-wish.is-in .om-bday-tree-sub { opacity: 1; transform: translateY(0px); filter: blur(0px); }

.om-bday-tree-wish.is-in .om-bday-tree-rule { opacity: 1; transform: translateY(0px) scaleX(1); transition-delay: 1.35s; }

.om-bday-tree-wish.is-in .om-bday-tree-sub { transition-delay: 1.55s; }

.om-bday-tree-wish.is-in .om-bday-tree-hero { animation: 1.2s cubic-bezier(0.62, 0.04, 0.24, 1) 0.35s 1 normal forwards running om-bday-tree-write, 4s ease-in-out 1.9s infinite normal none running om-bday-tree-breath; }

.om-bday-tree-wish.is-in .om-bday-tree-herowrap::before { animation: 0.8s ease 0.3s 1 normal forwards running om-bday-tree-hlin, 3.4s ease-in-out 1.7s infinite normal none running om-bday-tree-hlpulse; }

.om-bday-tree-wish.is-in .om-bday-tree-herowrap::after { animation: 2.6s ease-in-out 1.6s infinite normal none running om-bday-tree-twk; }

@keyframes om-bday-tree-write { 
  0% { clip-path: inset(0px 100% -28% -10%); }
  100% { clip-path: inset(0px -10% -28%); }
}

@keyframes om-bday-tree-breath { 
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.02); }
}

@keyframes om-bday-tree-hlin { 
  0% { opacity: 0; transform: scale(0.86); }
  100% { opacity: 0.92; transform: scale(1); }
}

@keyframes om-bday-tree-hlpulse { 
  0%, 100% { opacity: 0.72; }
  50% { opacity: 1; }
}

@keyframes om-bday-tree-twk { 
  0%, 100% { opacity: 0; transform: scale(0.5) rotate(-12deg); }
  45% { opacity: 1; transform: scale(1.05) rotate(16deg); }
}

.om-bday-tree-tap { position: absolute; left: 0px; right: 0px; bottom: calc(22px + env(safe-area-inset-bottom,0px)); z-index: 7; text-align: center; font-size: 13px; letter-spacing: 0.04em; color: rgb(156, 107, 116); text-shadow: rgba(255, 248, 241, 0.9) 0px 1px 2px; opacity: 0; transition: opacity 0.6s; pointer-events: none; }

.om-bday-tree-tap.is-in { opacity: 0.82; }

@media (prefers-reduced-motion: reduce) {
  .om-bday-tree-wish .om-bday-tree-eyebrow, .om-bday-tree-wish .om-bday-tree-rule, .om-bday-tree-wish .om-bday-tree-sub { opacity: 1; transform: none; filter: none; transition: none; }
  .om-bday-tree-hero { clip-path: none; filter: drop-shadow(rgba(255, 252, 248, 0.98) 0px 0px 5px) drop-shadow(rgba(130, 18, 55, 0.5) 0px 2px 4px); }
  .om-bday-tree-wish.is-in .om-bday-tree-hero { animation: auto ease 0s 1 normal none running none; }
  .om-bday-tree-wish.is-in .om-bday-tree-herowrap::before { animation: auto ease 0s 1 normal none running none; opacity: 0.9; }
  .om-bday-tree-wish.is-in .om-bday-tree-herowrap::after { animation: auto ease 0s 1 normal none running none; opacity: 0; }
}

.om-bday-film-hero { position: absolute; inset: 0px; z-index: 3; overflow: hidden; }

.om-bday-film-herobg { position: absolute; inset: 0px; background: radial-gradient(120% 88% at 50% 24%, rgb(255, 248, 241) 0px, rgb(255, 246, 238) 38%, rgb(249, 226, 210) 74%, rgb(242, 201, 184) 100%); }

.om-bday-film-herobg::after { content: ""; position: absolute; left: 50%; top: 44%; width: min(78vw, 720px); aspect-ratio: 1 / 1; transform: translate(-50%, -50%); background: radial-gradient(circle, rgba(255, 190, 150, 0.55), rgba(255, 150, 170, 0.16) 46%, transparent 70%); filter: blur(6px); }

.om-bday-film-motes { position: absolute; inset: 0px; pointer-events: none; }

.om-bday-film-mote { position: absolute; border-radius: 50%; background: radial-gradient(circle, rgba(255, 236, 214, 0.9), rgba(255, 206, 180, 0.15) 55%, transparent 72%); will-change: transform, opacity; }

.om-bday-film-eyebrow { position: absolute; top: 13%; left: 0px; right: 0px; text-align: center; font-family: var(--bd-font-display); font-style: italic; font-weight: 600; font-size: clamp(15px, 3.6vw, 26px); letter-spacing: 0.06em; color: rgb(168, 80, 105); text-shadow: rgba(255, 248, 241, 0.9) 0px 1px 10px; opacity: 0; }

.om-bday-film-targetwrap { position: absolute; top: 33%; left: 0px; right: 0px; display: flex; justify-content: center; transform: translateY(-50%); pointer-events: none; }

.om-bday-film-target { position: relative; width: clamp(120px, 27vw, 208px); aspect-ratio: 100 / 92; will-change: transform; transform-origin: 50% 60%; }

.om-bday-film-targetheart { position: absolute; inset: 0px; display: block; }

.om-bday-film-heartglow { position: absolute; left: 50%; top: 52%; width: 230%; aspect-ratio: 1 / 1; transform: translate(-50%, -50%) scale(1); border-radius: 50%; background: radial-gradient(circle, rgba(255, 120, 150, 0.55), rgba(255, 90, 130, 0.18) 42%, transparent 68%); filter: blur(4px); pointer-events: none; will-change: transform, opacity; }

.om-bday-film-heartsvg { width: 100%; height: 100%; display: block; transform-origin: 50% 60%; filter: drop-shadow(rgba(168, 15, 64, 0.34) 0px 10px 22px) drop-shadow(rgba(120, 10, 48, 0.3) 0px 3px 6px); will-change: transform; }

.om-bday-film-archery { position: absolute; top: 0px; left: 0px; width: clamp(100px, 18vw, 168px); cursor: grab; -webkit-tap-highlight-color: transparent; touch-action: none; will-change: transform; }

.om-bday-film-archery:active { cursor: grabbing; }

.om-bday-film-archery:focus-visible { outline: 0px; }

.om-bday-film-archery:focus-visible .om-bday-film-bow { }

.om-bday-film-bow { display: block; width: 100%; height: auto; filter: drop-shadow(rgba(90, 40, 15, 0.3) 0px 12px 18px); overflow: visible; }

.om-bday-film-aim { position: absolute; left: 50%; bottom: 32%; width: 2px; height: 190%; margin-left: -1px; transform-origin: center bottom; background: linear-gradient(0deg, rgba(255, 214, 150, 0.6) 0px, rgba(255, 150, 170, 0.22) 52%, transparent 78%); opacity: 0; pointer-events: none; }

.om-bday-film-arrow { position: absolute; left: 0px; right: 0px; margin-inline: auto; bottom: 36%; width: 17.5%; height: auto; overflow: visible; will-change: transform; filter: drop-shadow(rgba(90, 40, 15, 0.36) 0px 5px 7px); }

.om-bday-film-wings { transform-box: fill-box; transform-origin: 50% 90%; }

.om-bday-film-wingL, .om-bday-film-wingR { transform-box: fill-box; }

.om-bday-film-wingL { transform-origin: 88% 60%; animation: 2.6s ease-in-out 0s infinite normal none running om-bday-film-flapL; }

.om-bday-film-wingR { transform-origin: 12% 60%; animation: 2.6s ease-in-out 0s infinite normal none running om-bday-film-flapR; }

@keyframes om-bday-film-flapL { 
  0%, 100% { transform: rotate(0deg); }
  50% { transform: rotate(-11deg); }
}

@keyframes om-bday-film-flapR { 
  0%, 100% { transform: rotate(0deg); }
  50% { transform: rotate(11deg); }
}

.om-bday-film-hint { position: absolute; bottom: 8.5%; left: 0px; right: 0px; text-align: center; font-family: var(--bd-font-display); font-weight: 600; font-style: italic; font-size: clamp(13px, 3.1vw, 19px); letter-spacing: 0.16em; text-transform: uppercase; color: rgb(176, 106, 124); opacity: 0; }

.om-bday-film-flood { position: absolute; left: 50%; top: 50%; width: 140px; height: 140px; margin: -70px 0px 0px -70px; border-radius: 50%; background: radial-gradient(circle at 40% 34%, rgb(255, 95, 134), rgb(212, 35, 92) 46%, rgb(168, 15, 67) 100%); z-index: 5; opacity: 0; transform: scale(0.001); will-change: transform, opacity; pointer-events: none; }

.om-bday-film-field { position: absolute; inset: 0px; z-index: 4; opacity: 0; pointer-events: none; overflow: hidden; background: radial-gradient(120% 100% at 50% 8%, rgb(213, 38, 95) 0px, rgb(212, 35, 92) 42%, rgb(168, 15, 67) 78%, rgb(110, 10, 49) 100%); color: rgb(255, 255, 255); }

.om-bday-film-blob { position: absolute; border-radius: 50%; filter: blur(46px); opacity: 0; mix-blend-mode: screen; will-change: transform, opacity; }

.om-bday-film-blob-1 { width: 58vmax; height: 58vmax; left: -18vmax; top: -16vmax; background: radial-gradient(circle, rgba(255, 130, 160, 0.9), transparent 62%); }

.om-bday-film-blob-2 { width: 46vmax; height: 46vmax; right: -14vmax; top: 22vmax; background: radial-gradient(circle, rgba(255, 90, 120, 0.75), transparent 64%); }

.om-bday-film-blob-3 { width: 52vmax; height: 52vmax; left: 24vmax; bottom: -22vmax; background: radial-gradient(circle, rgba(180, 20, 70, 0.8), transparent 66%); }

.om-bday-film-fgrid { position: absolute; inset: -6%; background-image: linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px); background-size: clamp(38px, 7vw, 74px) clamp(38px, 7vw, 74px); will-change: transform; }

.om-bday-film-fvignette { position: absolute; inset: 0px; background: radial-gradient(128% 96% at 50% 44%, transparent 50%, rgba(70, 6, 28, 0.5) 100%); }

.om-bday-film-camera { position: absolute; inset: 0px; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: clamp(4px, 1.2vh, 12px); padding: 17vh 6vw; text-align: center; will-change: transform; }

.om-bday-film-keyebrow { font-family: var(--bd-font-display); font-style: italic; font-weight: 500; font-size: clamp(15px, 3.6vw, 27px); letter-spacing: 0.08em; color: rgb(255, 215, 200); opacity: 0; transform: translateY(10px); margin-bottom: clamp(2px, 1vh, 10px); }

.om-bday-film-headline { font-family: var(--bd-font-display); line-height: 0.92; }

.om-bday-film-hlline { display: block; font-size: clamp(52px, 15vw, 168px); letter-spacing: -0.02em; }

.om-bday-film-mask { display: inline-block; overflow: hidden; padding: 0.3em 0.14em 0.22em; margin: -0.3em -0.14em -0.22em; }

.om-bday-film-hlword { display: inline-block; font-weight: 900; font-size: 1em; color: rgb(255, 246, 241); text-shadow: rgba(60, 4, 24, 0.34) 0px 6px 34px, rgba(90, 8, 36, 0.42) 0px 2px 3px; }

.om-bday-film-hlch { display: inline-block; will-change: transform; }

.om-bday-film-uline { width: clamp(150px, 40vw, 380px); height: auto; margin-top: clamp(4px, 1.4vh, 14px); color: rgb(255, 207, 106); filter: drop-shadow(rgba(255, 180, 90, 0.5) 0px 2px 8px); }

.om-bday-film-ksub { margin-top: clamp(12px, 2.4vh, 26px); font-family: var(--bd-font-display); font-weight: 500; font-style: italic; font-size: clamp(14px, 3.4vw, 24px); letter-spacing: 0.05em; color: rgb(255, 223, 210); opacity: 0; transform: translateY(10px); }

.om-bday-film-bar { position: absolute; left: 0px; right: 0px; height: 16vh; background: rgb(18, 4, 11); z-index: 3; will-change: transform; pointer-events: none; }

.om-bday-film-bar-top { top: 0px; }

.om-bday-film-bar-bot { bottom: 0px; }

.om-bday-film-bloom { position: absolute; left: 50%; top: 50%; width: 60px; height: 60px; margin: -30px 0px 0px -30px; border-radius: 50%; background: radial-gradient(circle, rgb(255, 255, 255) 0px, rgb(255, 242, 214) 30%, rgba(255, 214, 150, 0.85) 55%, rgba(255, 190, 150, 0) 74%); z-index: 8; opacity: 0; transform: scale(0.001); will-change: transform, opacity; pointer-events: none; }

.om-bday-film-burst { position: absolute; z-index: 4; pointer-events: none; }

@media (prefers-reduced-motion: reduce) {
  .om-bday-film-bloom, .om-bday-film-field, .om-bday-film-flood, .om-bday-film-hero { display: none !important; }
