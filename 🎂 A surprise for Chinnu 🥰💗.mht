.om-bday-cake-title { font-family: var(--bd-font-display); font-size: 22px; font-weight: 600; margin-bottom: 4px; }

.om-bday-hbc-confetti { position: absolute; inset: 0px; width: 100%; height: 100%; pointer-events: none; z-index: 0; }

#om-bday-scene-cake .om-bday-scene-inner { position: relative; z-index: 1; }

.om-bday-hbc { --hbc-body: #a88679; --hbc-fill: #8b6a60; --hbc-frost: #fefae9; position: relative; width: 220px; height: 232px; margin: 8px auto 4px; }

