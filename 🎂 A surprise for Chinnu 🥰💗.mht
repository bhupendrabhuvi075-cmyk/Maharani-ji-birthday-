.om-bday-hbc[data-cake="p"] { --hbc-body: #F5A9C4; --hbc-fill: #D96D97; --hbc-frost: #FFF6FA; }

.om-bday-hbc[data-cake="g"] { --hbc-body: #EDD59E; --hbc-fill: #C9A45C; --hbc-frost: #FFF8EE; }

.om-bday-hbc-body { fill: var(--hbc-body); }

.om-bday-hbc-fill { fill: var(--hbc-fill); }

.om-bday-hbc-frost { fill: var(--hbc-frost); }

